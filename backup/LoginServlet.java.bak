package com.internshipportal.servlet;

import java.io.IOException;
import java.net.URLEncoder;
import java.util.Date;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import com.internshipportal.model.User;
import com.internshipportal.service.UserService;

/**
 * LoginServlet - Authenticates students and establishes HTTP session tracking.
 * Phase 4 requirement: Process login using Servlets (POST), validate credentials,
 * create and maintain HttpSession, and redirect to the JSP dashboard.
 */
@WebServlet("/LoginServlet")
public class LoginServlet extends HttpServlet {

    private static final long serialVersionUID = 1L;
    private UserService userService;

    @Override
    public void init() throws ServletException {
        super.init();
        this.userService = new UserService();
    }

    /**
     * Handles HTTP GET requests.
     * If user is already authenticated in an active session, forwards them straight
     * to their dashboard; otherwise displays the login page.
     */
    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        HttpSession session = request.getSession(false);
        if (session != null && session.getAttribute("currentUser") != null) {
            response.sendRedirect(request.getContextPath() + "/dashboard.jsp");
            return;
        }

        response.sendRedirect(request.getContextPath() + "/login.html");
    }

    /**
     * Handles HTTP POST requests.
     * Authenticates username/email and password against the server-side UserService,
     * stores the authenticated User in HttpSession, and redirects to dashboard.jsp.
     */
    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        request.setCharacterEncoding("UTF-8");
        response.setContentType("text/html;charset=UTF-8");

        String usernameOrEmail = request.getParameter("username");
        String password = request.getParameter("password");

        // 1. Server-Side Non-Empty Validation
        if (usernameOrEmail == null || usernameOrEmail.trim().isEmpty()
                || password == null || password.trim().isEmpty()) {

            String errorMsg = "Please enter both username/email and password.";
            String redirectUrl = request.getContextPath()
                    + "/login.html?error=" + URLEncoder.encode(errorMsg, "UTF-8");
            response.sendRedirect(redirectUrl);
            return;
        }

        String cleanUsername = usernameOrEmail.trim();

        // 2. Server-Side Authentication using UserService
        boolean isAuthenticated = userService.authenticate(cleanUsername, password);

        if (isAuthenticated) {
            User user = userService.findByUsernameOrEmail(cleanUsername);

            // 3. Establish Authenticated Session (HttpSession)
            HttpSession session = request.getSession(true); // Creates session if none exists
            session.setAttribute("currentUser", user);
            session.setAttribute("username", user.getUsername());
            session.setAttribute("fullName", user.getFullName());
            session.setAttribute("email", user.getEmail());
            session.setAttribute("course", user.getCourse());
            session.setAttribute("loginTime", new Date());

            // 4. Secure Redirect to Authenticated JSP Dashboard
            response.sendRedirect(request.getContextPath() + "/dashboard.jsp");

        } else {
            // Authentication Failure
            String errorMsg = "Incorrect username/email or password. Please try again.";
            String redirectUrl = request.getContextPath()
                    + "/login.html?error=" + URLEncoder.encode(errorMsg, "UTF-8");
            response.sendRedirect(redirectUrl);
        }
    }
}
