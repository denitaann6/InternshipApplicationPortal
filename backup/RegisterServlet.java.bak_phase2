package com.internshipportal.servlet;

import java.io.IOException;
import java.net.URLEncoder;
import javax.servlet.ServletException;
import javax.servlet.annotation.WebServlet;
import javax.servlet.http.HttpServlet;
import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;

import com.internshipportal.exception.InvalidInputException;
import com.internshipportal.model.User;
import com.internshipportal.service.UserService;

/**
 * RegisterServlet - Handles student registration in the CareerLaunch Portal.
 * Phase 4 requirement: Process registration using Servlets (POST),
 * validate credentials on the server side, and prevent duplicate accounts.
 */
@WebServlet(name = "RegisterServlet", urlPatterns = {"/RegisterServlet"})
public class RegisterServlet extends HttpServlet {

    private static final long serialVersionUID = 1L;
    private UserService userService;

    @Override
    public void init() throws ServletException {
        super.init();
        // Use shared singleton UserService instance
        this.userService = UserService.getInstance();
    }

    /**
     * Handles HTTP GET requests.
     * Redirects directly to the registration page.
     */
    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        response.sendRedirect(request.getContextPath() + "/register.html");
    }

    /**
     * Handles HTTP POST requests.
     * Extracts form inputs, performs server-side validation, checks for duplicates,
     * registers the user in the repository, and redirects to login on success.
     */
    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        request.setCharacterEncoding("UTF-8");
        response.setContentType("text/html;charset=UTF-8");

        // 1. Extract form fields submitted by the client
        String fullName = request.getParameter("fullName");
        String username = request.getParameter("username");
        String email = request.getParameter("email");
        String phone = request.getParameter("phone");
        String course = request.getParameter("course");
        String interest = request.getParameter("interest");
        String password = request.getParameter("password");
        String confirmPassword = request.getParameter("confirmPassword");
       String terms = request.getParameter("terms");

if (terms == null) {
    response.sendRedirect(
        request.getContextPath()
        + "/register.html?error=Please+accept+the+terms+and+conditions"
    );
    return;
}

        // Trim values
        fullName = (fullName != null) ? fullName.trim() : "";
        username = (username != null) ? username.trim() : "";
        email = (email != null) ? email.trim() : "";
        phone = (phone != null) ? phone.trim() : "";
        course = (course != null) ? course.trim() : "";
        interest = (interest != null) ? interest.trim() : "";

        // 2. Comprehensive Server-Side Validation
        String validationError = null;

        if (fullName.isEmpty()) {
            validationError = "Please enter your full name.";
        } else if (username.isEmpty()) {
            validationError = "Please enter a username.";
        } else if (username.contains(" ")) {
            validationError = "Username must not contain any spaces.";
        } else if (email.isEmpty() || !email.matches("^[A-Za-z0-9+_.-]+@(.+)$")) {
            validationError = "Please provide a valid email address.";
        } else if (phone.isEmpty() || !phone.matches("^\\d{10}$")) {
            validationError = "Please enter a valid 10-digit phone number.";
        } else if (course.isEmpty()) {
            validationError = "Please select your course of study.";
        } else if (password == null || password.length() < 6) {
            validationError = "Password must be at least 6 characters long.";
        } else if (!password.equals(confirmPassword)) {
            validationError = "Passwords do not match.";
        }

        // Return error to registration page if validation fails
        if (validationError != null) {
            String redirectUrl = request.getContextPath()
                    + "/register.html?error=" + URLEncoder.encode(validationError, "UTF-8");
            response.sendRedirect(redirectUrl);
            return;
        }

        // 3. Register user via UserService and handle domain exceptions
        try {
            User newUser = new User(
                    0, // ID will be auto-generated by UserService
                    username,
                    password,
                    email,
                    fullName,
                    phone,
                    course,
                    interest
            );

            userService.registerUser(newUser);

            // 4. Redirect to login page with success notification
            String successMessage = "Registration successful! Please sign in with your credentials.";
            String redirectUrl = request.getContextPath()
                    + "/login.html?registered=true&msg="
                    + URLEncoder.encode(successMessage, "UTF-8");
            response.sendRedirect(redirectUrl);

        } catch (InvalidInputException e) {
            // Duplicate username/email or validation rule caught from service layer
            String redirectUrl = request.getContextPath()
                    + "/register.html?error=" + URLEncoder.encode(e.getMessage(), "UTF-8");
            response.sendRedirect(redirectUrl);
        }
    }
}
