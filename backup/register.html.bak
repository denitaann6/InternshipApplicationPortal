<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CareerLaunch | Create Account</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <div class="register-page">

        <!-- Header -->
        <header class="register-header">

            <div class="brand">
                <div class="brand-icon">✦</div>
                <span>CareerLaunch</span>
            </div>

            <div class="login-text">
                Already have an account?
                <a href="login.html">Sign In</a>
            </div>

        </header>


        <!-- Registration Content -->
        <main class="register-container">

            <div class="register-heading">

                <p>CREATE YOUR PROFILE</p>

                <h1>Build your career journey.</h1>

                <span>
                    Create your account and discover internship
                    opportunities made for your career goals.
                </span>

            </div>


            <div class="register-card">

                <form id="registerForm">

                    <!-- Personal Information -->
                    <div class="section-title">
                        <span>01</span>
                        Personal Information
                    </div>


                    <div class="form-row">

                        <div class="input-group">

                            <label for="fullName">
                                Full Name
                            </label>

                            <input
                                type="text"
                                id="fullName"
                                placeholder="Enter your full name"
                            >

                            <small id="fullNameError"></small>

                        </div>


                        <div class="input-group">

                            <label for="username">
                                Username
                            </label>

                            <input
                                type="text"
                                id="registerUsername"
                                placeholder="Choose a username"
                            >

                            <small id="registerUsernameError"></small>

                        </div>

                    </div>


                    <div class="form-row">

                        <div class="input-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="registerEmail"
                                placeholder="you@example.com"
                            >

                            <small id="emailError"></small>

                        </div>


                        <div class="input-group">

                            <label for="phone">
                                Phone Number
                            </label>

                            <input
                                type="tel"
                                id="phone"
                                placeholder="Enter phone number"
                            >

                            <small id="phoneError"></small>

                        </div>

                    </div>


                    <!-- Academic Information -->
                    <div class="section-title">
                        <span>02</span>
                        Academic Information
                    </div>


                    <div class="form-row">

                        <div class="input-group">

                            <label for="course">
                                Course
                            </label>

                            <select id="course">

                                <option value="">
                                    Select your course
                                </option>

                                <option value="MCA">
                                    MCA
                                </option>

                                <option value="BCA">
                                    BCA
                                </option>

                                <option value="BTech">
                                    B.Tech
                                </option>

                                <option value="MSc">
                                    M.Sc
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                            <small id="courseError"></small>

                        </div>


                        <div class="input-group">

                            <label for="interest">
                                Internship Interest
                            </label>

                            <select id="interest">

                                <option value="">
                                    Select your interest
                                </option>

                                <option value="Java Development">
                                    Java Development
                                </option>

                                <option value="Web Development">
                                    Web Development
                                </option>

                                <option value="Data Science">
                                    Data Science
                                </option>

                                <option value="Cyber Security">
                                    Cyber Security
                                </option>

                                <option value="AI & ML">
                                    AI & ML
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- Account Security -->
                    <div class="section-title">
                        <span>03</span>
                        Account Security
                    </div>


                    <div class="form-row">

                        <div class="input-group">

                            <label for="registerPassword">
                                Password
                            </label>

                            <input
                                type="password"
                                id="registerPassword"
                                placeholder="Create a password"
                            >

                            <small id="registerPasswordError"></small>

                        </div>


                        <div class="input-group">

                            <label for="confirmPassword">
                                Confirm Password
                            </label>

                            <input
                                type="password"
                                id="confirmPassword"
                                placeholder="Confirm your password"
                            >

                            <small id="confirmPasswordError"></small>

                        </div>

                    </div>


                    <!-- Terms -->
                    <div class="terms">

                        <label>

                            <input
                                type="checkbox"
                                id="terms"
                            >

                            I agree to the
                            <a href="#">Terms & Conditions</a>
                            and
                            <a href="#">Privacy Policy</a>.

                        </label>

                        <small id="termsError"></small>

                    </div>


                    <!-- Submit -->
                    <button
                        type="submit"
                        class="register-button">

                        Create My Account
                        <span>→</span>

                    </button>


                    <p class="bottom-login">

                        Already registered?

                        <a href="login.html">
                            Sign in here
                        </a>

                    </p>

                </form>

            </div>

        </main>

    </div>


    <script src="js/validation.js"></script>

</body>

</html>