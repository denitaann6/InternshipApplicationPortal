<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1"
         metadata-complete="true">

    <display-name>CareerLaunch Internship Application Portal</display-name>

    <description>
        26MCA1L211: Java and Web Programming Practical
        Phase 4: Server-Side Integration and Execution
        Demonstrating Servlets, HttpSession, JSP Dashboard, and Access Control.
    </description>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Register Servlet -->
    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/RegisterServlet</url-pattern>
    </servlet-mapping>

    <!-- Login Servlet -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/LoginServlet</url-pattern>
    </servlet-mapping>

    <!-- Logout Servlet -->
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/LogoutServlet</url-pattern>
    </servlet-mapping>

    <!-- Application Servlet (Student Application Submission) -->
    <servlet>
        <servlet-name>ApplicationServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.ApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/ApplicationServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ApplicationServlet</servlet-name>
        <url-pattern>/apply</url-pattern>
    </servlet-mapping>

    <!-- Admin Application Servlet (Recruitment Status Management) -->
    <servlet>
        <servlet-name>AdminApplicationServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.AdminApplicationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminApplicationServlet</servlet-name>
        <url-pattern>/AdminApplicationServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminApplicationServlet</servlet-name>
        <url-pattern>/admin/update-status</url-pattern>
    </servlet-mapping>

    <!-- Admin Internship Servlet (Internship Lifecycle Management) -->
    <servlet>
        <servlet-name>AdminInternshipServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.AdminInternshipServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminInternshipServlet</servlet-name>
        <url-pattern>/AdminInternshipServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AdminInternshipServlet</servlet-name>
        <url-pattern>/admin/internships</url-pattern>
    </servlet-mapping>

    <!-- Profile Servlet (Student Profile Management) -->
    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/ProfileServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile/update</url-pattern>
    </servlet-mapping>

    <!-- Contact Servlet (Contact & Support Inquiry Handler) -->
    <servlet>
        <servlet-name>ContactServlet</servlet-name>
        <servlet-class>com.internshipportal.servlet.ContactServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ContactServlet</servlet-name>
        <url-pattern>/ContactServlet</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ContactServlet</servlet-name>
        <url-pattern>/contact/submit</url-pattern>
    </servlet-mapping>

    <!-- Authentication Filter -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.internshipportal.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/dashboard.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/profile.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/applications.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/dashboard.html</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/ApplicationServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/apply</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/ProfileServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/profile/update</url-pattern>
    </filter-mapping>

    <!-- Admin Authorization Filter (Role-Based Access Control) -->
    <filter>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <filter-class>com.internshipportal.filter.AdminAuthorizationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/admin-dashboard.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/admin-internships.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/admin-applications.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/admin-audit.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/admin-students.jsp</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/AdminApplicationServlet</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminAuthorizationFilter</filter-name>
        <url-pattern>/AdminInternshipServlet</url-pattern>
    </filter-mapping>

    <!-- Session Configuration: 30 minutes inactivity timeout -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
    </session-config>

</web-app>
